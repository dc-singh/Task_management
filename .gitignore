# ==============================================================================
# SECRETS, CREDENTIALS & ENVIRONMENT CONFIGURATIONS
# ==============================================================================
# Environment files containing sensitive keys, passwords, and DB connections
.env
.env.*
.env.local
.env.development
.env.test
.env.production
*.env

# Keep template/example files safe to share
!.env.example
!.env.template

# Private keys, certificates, and auth credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*id_rsa*
*id_ed25519*
*id_ecdsa*
*id_dsa*

# Cloud & Service Account API keys / credentials
*credentials*.json
*client_secret*.json
service_account*.json
firebase_credentials*.json
gcp_credentials*.json
aws_credentials*
.aws/
.azure/
.gcp/
token.json
tokens.json
secrets/
.secrets/

# ==============================================================================
# LOCAL DATABASES, STORAGE & BACKUPS
# ==============================================================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite3-journal
*.db-wal
*.db-shm
*.sql
*.dump
*.bak
*.backup
instance/
local_data/
data/

# ==============================================================================
# PYTHON VIRTUAL ENVIRONMENTS & PACKAGING
# ==============================================================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg


# ==============================================================================
# PYTHON BYTECODE & RUNTIME CACHES
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ==============================================================================
# LOGS, RUNTIME ARTIFACTS & PROCESS FILES
# ==============================================================================
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.seed
*.pid.lock

# ==============================================================================
# IDE, EDITORS & API CLIENT CONFIGURATIONS
# ==============================================================================
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.openpost/
.postman/
.openpost_history/

# ==============================================================================
